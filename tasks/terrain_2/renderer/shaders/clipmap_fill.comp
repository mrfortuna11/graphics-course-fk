#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, r32f) restrict writeonly uniform image2DArray heightmapArray;
layout(binding = 1) uniform sampler2D detailTex;

layout(push_constant) uniform PC
{
  vec2  levelOrigin;      // world XZ of texel (0,0)
  float gridStep;         // world units per texel
  int   levelIdx;
  float hillsWeight;      // weight of perlin(p) at 256m
  float ridgesWeight;     // weight of abs(perlin(p*0.125)) at 2048m
  float detailAmplitude;  // strength of detail tile contribution
};

const float DETAIL_WORLD_PERIOD = 256.0; // tile repeats every 256m
const float DETAIL_TEX_SIZE     = 512.0;
const float DETAIL_MAX_LOD      = 8.0;

vec2 randomGradient(in ivec2 coord)
{
  const uint w = 32u;
  const uint s = w / 2u;
  uint a = uint(coord.x);
  uint b = uint(coord.y);
  a *= 3284157443u;
  b ^= a << s | a >> w - s;
  b *= 1911520717u;
  a ^= b << s | b >> w - s;
  a *= 2048419325u;
  float r = float(a) * (3.14159265 / float(~(~0u >> 1u)));
  return vec2(cos(r), sin(r));
}

float dotGridGradient(in vec2 pixCoord, in ivec2 gridCoord)
{
  return dot(randomGradient(gridCoord), pixCoord - vec2(gridCoord));
}

float perlin(in vec2 p)
{
  int x0 = int(floor(p.x)), x1 = x0 + 1;
  int y0 = int(floor(p.y)), y1 = y0 + 1;
  vec2 s = (3.0 - (p - vec2(x0, y0)) * 2.0) * (p - vec2(x0, y0)) * (p - vec2(x0, y0));
  float n0 = dotGridGradient(p, ivec2(x0, y0));
  float n1 = dotGridGradient(p, ivec2(x1, y0));
  float ix0 = mix(n0, n1, s.x);
  n0 = dotGridGradient(p, ivec2(x0, y1));
  n1 = dotGridGradient(p, ivec2(x1, y1));
  return mix(ix0, mix(n0, n1, s.x), s.y);
}

void main()
{
  ivec2 c = ivec2(gl_GlobalInvocationID.xy);
  if (c.x >= 256 || c.y >= 256)
    return;

  vec2 worldXZ = levelOrigin + vec2(c) * gridStep;

  vec2 p = (worldXZ + 512.0) / 256.0;
  float hills  = perlin(p);
  float ridges = abs(perlin(p * 0.125));
  float h = (hills * hillsWeight + ridges * ridgesWeight)
          / max(hillsWeight + ridgesWeight, 0.01);

  float detailLod = clamp(
    log2(gridStep * DETAIL_TEX_SIZE / DETAIL_WORLD_PERIOD), 0.0, DETAIL_MAX_LOD);
  h += textureLod(detailTex, worldXZ / DETAIL_WORLD_PERIOD, detailLod).r * detailAmplitude;

  imageStore(heightmapArray, ivec3(c, levelIdx), vec4(h, 0.0, 0.0, 0.0));
}
