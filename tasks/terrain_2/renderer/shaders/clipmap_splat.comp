#version 450

// Bakes the per-level material (splatted albedo) into a 2D-array texture.
// Layout mirrors the heightmap array: 256x256 texels per level, one layer per level.

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2DArray heightmapArray;
layout(binding = 1, rgba8) writeonly uniform image2DArray albedoArray;

layout(push_constant) uniform PC
{
  vec2  levelOrigin;  // world XZ of texel (0,0)
  float gridStep;     // world units per texel
  int   levelIdx;
  vec4  splatParams;  // x=heightLow, y=heightHigh, z=blendSharp, w=slopeThreshold
  float heightScale;  // raw_h * heightScale = world-space Y
};

const float HEIGHTMAP_SIZE = 256.0;
const int   HEIGHTMAP_SIZE_I = 256;

const vec3 COL_SAND  = vec3(0.78, 0.70, 0.50);
const vec3 COL_GRASS = vec3(0.30, 0.45, 0.18);
const vec3 COL_ROCK  = vec3(0.42, 0.38, 0.34);
const vec3 COL_SNOW  = vec3(0.92, 0.94, 0.97);

float hash21(vec2 p)
{
  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

float valueNoise(vec2 p)
{
  vec2 i = floor(p);
  vec2 f = fract(p);
  vec2 u = f * f * (3.0 - 2.0 * f);
  float a = hash21(i + vec2(0.0, 0.0));
  float b = hash21(i + vec2(1.0, 0.0));
  float c = hash21(i + vec2(0.0, 1.0));
  float d = hash21(i + vec2(1.0, 1.0));
  return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

float sampleH(ivec2 c)
{
  c = clamp(c, ivec2(0), ivec2(HEIGHTMAP_SIZE_I - 1));
  vec2 uv = (vec2(c) + 0.5) / HEIGHTMAP_SIZE;
  return texture(heightmapArray, vec3(uv, float(levelIdx))).r;
}

void main()
{
  ivec2 c = ivec2(gl_GlobalInvocationID.xy);
  if (c.x >= HEIGHTMAP_SIZE_I || c.y >= HEIGHTMAP_SIZE_I)
    return;

  // Texel center → world XZ.
  vec2 worldXZ = levelOrigin + vec2(c) * gridStep;

  // Heights at center + 4 neighbors (for normal via central differences).
  float hC = sampleH(c);
  float hL = sampleH(c + ivec2(-1,  0));
  float hR = sampleH(c + ivec2( 1,  0));
  float hD = sampleH(c + ivec2( 0, -1));
  float hU = sampleH(c + ivec2( 0,  1));

  float worldY = hC * heightScale;

  // Same convention as the vertex shader morphing tangents (Y-up):
  //   tangentX = (2*step, (hR-hL)*hs, 0)
  //   tangentZ = (0, (hU-hD)*hs, 2*step)
  //   normal   = normalize(cross(tangentZ, tangentX)) → ((hL-hR)*hs, 2*step, (hD-hU)*hs)
  vec3 n = normalize(vec3(
    (hL - hR) * heightScale,
    2.0 * gridStep,
    (hD - hU) * heightScale));

  float slope = 1.0 - clamp(n.y, 0.0, 1.0);

  // ---- Same splatting logic as splatAlbedo() in clipmap_terrain.frag ----
  float heightLow  = splatParams.x;
  float heightHigh = splatParams.y;
  float blendSharp = max(splatParams.z, 0.5);
  float slopeThr   = splatParams.w;

  float n0 = valueNoise(worldXZ * 0.05);
  float n1 = valueNoise(worldXZ * 0.5 + 17.3);
  float variation = mix(0.85, 1.15, n0 * 0.6 + n1 * 0.4);

  float wSand  = 1.0 - smoothstep(heightLow  - blendSharp, heightLow  + blendSharp, worldY);
  float wSnow  = smoothstep(heightHigh - blendSharp, heightHigh + blendSharp, worldY);
  float wGrass = clamp(1.0 - wSand - wSnow, 0.0, 1.0);

  float wRock = smoothstep(slopeThr - 0.15, slopeThr + 0.05, slope);
  wGrass *= (1.0 - wRock);
  wSand  *= (1.0 - wRock);
  wSnow  *= (1.0 - wRock);

  vec3 albedo = COL_SAND  * wSand
              + COL_GRASS * wGrass
              + COL_SNOW  * wSnow
              + COL_ROCK  * wRock;

  albedo *= variation;

  imageStore(albedoArray, ivec3(c, levelIdx), vec4(albedo, 1.0));
}
