#version 460

layout(local_size_x = 64) in;

layout(push_constant) uniform PC
{
  mat4 projView;
  uint instanceCount;
  uint relemCount;
} pc;

layout(set = 0, binding = 0) readonly buffer AllInstanceMatrices  { mat4  matrices[]; };
layout(set = 0, binding = 1) readonly buffer InstanceMeshIds      { uint  meshId[];   };
layout(set = 0, binding = 2) readonly buffer MeshRelemRanges      { uvec2 range[];    };
layout(set = 0, binding = 3) readonly buffer RelemAabbs           { vec4  aabb[];     };
layout(set = 0, binding = 4) readonly buffer RelemInstanceOffsets { uint  offsets[];  };
layout(set = 0, binding = 5)          buffer RelemWriteCursors    { uint  cursors[];  };
layout(set = 0, binding = 6)          buffer VisibleMatrices      { mat4  visible[];  };

vec4 matRow(mat4 m, int i)
{
  return vec4(m[0][i], m[1][i], m[2][i], m[3][i]);
}

void main()
{
  uint instIdx = gl_GlobalInvocationID.x;
  if (instIdx >= pc.instanceCount)
    return;

  mat4  model = matrices[instIdx];
  uint  mId   = meshId[instIdx];
  uvec2 r     = range[mId];

  vec4 row0 = matRow(pc.projView, 0);
  vec4 row1 = matRow(pc.projView, 1);
  vec4 row2 = matRow(pc.projView, 2);
  vec4 row3 = matRow(pc.projView, 3);

  vec4 planes[6];
  planes[0] = row3 + row0;
  planes[1] = row3 - row0;
  planes[2] = row3 + row1;
  planes[3] = row3 - row1;
  planes[4] = row2;
  planes[5] = row3 - row2;

  for (uint k = 0u; k < r.y; ++k)
  {
    uint relemIdx = r.x + k;
    if (relemIdx >= pc.relemCount)
      break;

    vec3 mn = aabb[2u * relemIdx].xyz;
    vec3 mx = aabb[2u * relemIdx + 1u].xyz;

    bool culled = false;
    for (int p = 0; p < 6 && !culled; ++p)
    {
      vec3  n      = planes[p].xyz;
      float d      = planes[p].w;
      bool  allOut = true;

      for (int c = 0; c < 8 && allOut; ++c)
      {
        vec3 local = vec3(
          ((c & 1) != 0) ? mx.x : mn.x,
          ((c & 2) != 0) ? mx.y : mn.y,
          ((c & 4) != 0) ? mx.z : mn.z);
        vec3 world = (model * vec4(local, 1.0)).xyz;
        if (dot(n, world) + d >= 0.0)
          allOut = false;
      }

      if (allOut)
        culled = true;
    }

    if (!culled)
    {
      uint slot = atomicAdd(cursors[relemIdx], 1u);
      visible[offsets[relemIdx] + slot] = model;
    }
  }
}
